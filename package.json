{
  "name": "@ionos-cloud/codex",
  "description": "VDC & SDK swagger management tool",
  "version": "5.1.0",
  "author": "Florin Mihalache",
  "bin": {
    "codex": "bin/run"
  },
  "bugs": "https://github.com/ionos-cloud/codex/issues",
  "devDependencies": {
    "@oclif/test": "^3",
    "@types/chai": "^4.2.15",
    "@types/chai-as-promised": "^7.1.3",
    "@types/diff": "^5.0.0",
    "@types/mocha": "^10",
    "@types/mock-fs": "^4.13.0",
    "@types/node": "^20",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8",
    "eslint-config-oclif": "^5",
    "eslint-config-oclif-typescript": "^3",
    "mocha": "^10",
    "mock-fs": "^5",
    "nock": "^13",
    "nyc": "^17",
    "oclif": "^4",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/ionos-cloud/codex",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "codex",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ]
  },
  "repository": "ionos-cloud/codex",
  "scripts": {
    "postpack": "rm -f oclif.manifest.json",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "posttest": "npm run lint",
    "build": "rm -rf lib && tsc -b",
    "prepack": "rm -rf lib && tsc -b && oclif manifest && oclif readme",
    "test": "nyc mocha",
    "version": "oclif readme && git add README.md"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@oclif/core": "^3",
    "@oclif/plugin-autocomplete": "^3",
    "@oclif/plugin-help": "^6",
    "@aws-sdk/client-s3": "^3",
    "axios": "^1.7",
    "chalk": "^4",
    "diff": "^8.0.3",
    "enquirer": "^2.3.6",
    "tslib": "^2",
    "yaml": "^2"
  },
  "overrides": {
    "@oclif/core": {
      "minimatch": "10.2.1"
    },
    "filelist": {
      "minimatch": "10.2.1"
    }
  }
}
